@page "/empleados/detalle/{Id:int}" // Ruta con parámetro de ruta obligatorio de tipo integer
@inject ServicioEmpleados Servicio // Inyección del servicio para obtener los datos del empleado

<PageTitle>Detalle del Empleado</PageTitle> <!-- Título en la pestaña del navegador -->

<h1 class="mb-4">Detalle del Empleado</h1> <!-- Encabezado principal -->

<!-- Lógica de visualización condicional: existe o no el empleado -->
@if (_empleado is null)
{
    <div class="alert alert-warning">No se encontró un empleado con el ID @Id.</div> <!-- Alerta amarilla si no existe -->
}
else
{
    <div class="card" style="max-width: 500px;"> <!-- Tarjeta con los datos del empleado -->
        <div class="card-header bg-dark text-white"> <!-- Cabecera oscura con ID -->
            <strong>Empleado #@_empleado.Id</strong>
        </div>
        <!-- Lista de datos sin bordes (list-group-flush) -->
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Nombre:</strong> @_empleado.Nombre</li>
            <li class="list-group-item"><strong>Apellido:</strong> @_empleado.Apellido</li>
            <li class="list-group-item"><strong>Edad:</strong> @_empleado.Edad</li>
            <li class="list-group-item"><strong>Dirección:</strong> @_empleado.Direccion</li>
            <li class="list-group-item"><strong>Sexo:</strong> @_empleado.Sexo</li>
        </ul>
        <!-- Pie de tarjeta con acciones de Editar y Eliminar -->
        <div class="card-footer d-flex gap-2">
            <a class="btn btn-outline-warning" href="empleados/editar/@_empleado.Id"> <!-- Navega a la página de edición -->
                <i class="bi bi-pencil"></i> Editar
            </a>
            <a class="btn btn-outline-danger" href="empleados/eliminar/@_empleado.Id"> <!-- Navega a la página de confirmación de baja -->
                <i class="bi bi-trash3"></i> Eliminar
            </a>
        </div>
    </div>
}

<!-- Botón para volver a la lista general -->
<div class="mt-3">
    <a class="btn btn-secondary" href="empleados">
        <i class="bi bi-arrow-left"></i> Volver al listado
    </a>
</div>

@code {
    [Parameter] public int Id { get; set; } // Recibe el parámetro de la URL
    private Empleado? _empleado; // Variable para almacenar el empleado encontrado

    // Carga los datos al inicializar el componente
    protected override void OnInitialized()
    {
        _empleado = Servicio.ObtenerPorId(Id);
    }
}
