<!DOCTYPE html> <!-- Declaración de documento HTML5 -->
<!-- Página raíz con idioma español para accesibilidad y SEO -->
<html lang="es">

<head> <!-- Sección de metadatos y recursos de la página -->
    <meta charset="utf-8" /> <!-- Codificación UTF-8 para soportar caracteres especiales (tildes, ñ) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <!-- Configuración responsive: ancho del dispositivo, zoom inicial 1 -->
    <title>Registro de Empleados</title> <!-- Título por defecto de la pestaña del navegador -->
    <base href="/" /> <!-- URL base relativa: todas las rutas relativas se resuelven desde la raíz -->
    <!-- Bootstrap 5.3.3 cargado desde CDN: framework CSS que da los estilos de tarjetas, tablas, alertas y grid -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons 1.11.3 desde CDN: provee los iconos usados en toda la app (bi-person-plus, bi-trash3, etc.) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" /> <!-- Hoja de estilos personalizada del proyecto (wwwroot/app.css) -->
    <link rel="stylesheet" href="Web.styles.css" /> <!-- CSS en módulos generado automáticamente por Blazor (component scoped styles) -->
    <HeadOutlet @rendermode="InteractiveServer" /> <!-- Renderiza dinámicamente el <PageTitle> y otros elementos head de cada página -->
</head>

<body> <!-- Contenido visible de la página -->
    <!-- Componente Router: gestiona el enrutamiento entre páginas; InteractiveServer = interactividad vía SignalR -->
    <Routes @rendermode="InteractiveServer" />
    <!-- Script marco de Blazor: establece la conexión SignalR y arranca la aplicación interactiva -->
    <script src="_framework/blazor.web.js"></script>
</body>

</html>